PORT=4000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/gitmind?retryWrites=true&w=majority
REDIS_URL=redis://<host>:6379

# Your Netlify production site URL, without a trailing slash.
FRONTEND_URL=https://your-site.netlify.app

# Public URL of this API, without a trailing slash. This exact callback URL must
# also be configured in your GitHub OAuth App.
BACKEND_URL=https://api.example.com
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
JWT_SECRET=
