# ==============================================================================
# Git-Mind - Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to `.env` in the project root:
#   cp .env.example .env
#
# Use this single configuration for:
# - Backend Web Service (Render / local)
# - Frontend Application (Netlify / local)
# - AI Background Worker (Render / local)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Server & Network (Render / Express)
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=production

# Public URL of the deployed backend API (without trailing slash)
# - Render: https://<your-backend-subdomain>.onrender.com
# - Local: http://localhost:4000
BACKEND_URL=https://<your-backend-subdomain>.onrender.com

# Public URL of the deployed frontend (without trailing slash)
# - Netlify: https://<your-frontend-subdomain>.netlify.app
# - Local: http://localhost:5173
FRONTEND_URL=https://<your-frontend-subdomain>.netlify.app

# ------------------------------------------------------------------------------
# 2. Database & Message Queue Services
# ------------------------------------------------------------------------------
# MongoDB Atlas Connection URI:
# Create a free cluster at: https://www.mongodb.com/cloud/atlas
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/gitmind?retryWrites=true&w=majority

# Redis Message Queue:
# Create free serverless Redis at Upstash: https://console.upstash.com/redis
# Or use Render Redis / local: redis://localhost:6379
REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379

# ------------------------------------------------------------------------------
# 3. Authentication & Security
# ------------------------------------------------------------------------------
# JWT Signing Secret (32+ character random string)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters

# GitHub OAuth Application: https://github.com/settings/developers
# - Homepage URL: https://<your-frontend>.netlify.app
# - Callback URL: https://<your-backend>.onrender.com/auth/github/callback
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# ------------------------------------------------------------------------------
# 4. GitHub Integration & Webhooks
# ------------------------------------------------------------------------------
# GitHub Personal Access Token: https://github.com/settings/tokens
GITHUB_TOKEN=github_pat_your_token_here

# Webhook Secret configured in GitHub Repo -> Settings -> Webhooks
# Payload URL: https://<your-backend>.onrender.com/webhooks/github
GITHUB_WEBHOOK_SECRET=your_custom_webhook_secret

# Monitored GitHub Repository
GITHUB_REPO_OWNER=Yuvraj-Malik
GITHUB_REPO_NAME=git-mind-test

# ------------------------------------------------------------------------------
# 5. AI Worker & LLM Providers
# ------------------------------------------------------------------------------
# Google Gemini API Key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...

# Groq Cloud API Key: https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Local test repo path (for manual sandbox runs):
TEST_REPO_PATH=d:\My Programs\Software Engineering\git-mind-test-sandbox

# ------------------------------------------------------------------------------
# 6. Frontend Client Configuration (Vite)
# ------------------------------------------------------------------------------
# Backend API & WebSocket URLs consumed by the React app
VITE_API_URL=http://localhost:4000
VITE_SOCKET_URL=http://localhost:4000
VITE_ENABLE_SOCKET=true

# Firebase Web App Credentials: https://console.firebase.google.com/
# Project Settings > General > Your apps > SDK setup and configuration (Web)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ------------------------------------------------------------------------------
# 7. Automation, Security & Fixer settings (added Oct 2026)
# ------------------------------------------------------------------------------
# REQUIRED: backend refuses to start without it (min 16 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# JWT_SECRET=...
# REQUIRED for webhooks: unset secret now REJECTS every webhook (was: skipped verification)
# GITHUB_WEBHOOK_SECRET=...

# Who may log in (comma-separated GitHub usernames). Empty = any GitHub user.
ALLOWED_GITHUB_USERS=Yuvraj-Malik
# Repos the webhook may act on (owner/name, comma-separated). Default: GITHUB_REPO_OWNER/GITHUB_REPO_NAME
ALLOWED_REPOS=Yuvraj-Malik/git-mind-test-sandbox

# Where the worker clones target repos for webhook-triggered fixes (default: code/ai-worker/.workspaces)
# WORKSPACES_DIR=
# Base branch for manual/sandbox fixes (default main)
BASE_BRANCH=main
# Test/install commands for real repos (a repo can override with a committed .gitmind.json)
FIX_TEST_COMMAND=npm test
# FIX_INSTALL_COMMAND=npm ci --ignore-scripts
FIX_MODEL=gemini-2.5-flash
FIX_MAX_ATTEMPTS=3
FIX_RETRY_DELAY_MS=5000

# ------------------------------------------------------------------------------
# 8. Multi-repository mode (connect any repo from the UI)
# ------------------------------------------------------------------------------
# Users sign in with GitHub (scopes: repo, admin:repo_hook). Their token is stored
# AES-encrypted and used for syncing, cloning, pushing fix branches and opening PRs.
# GitHub OAuth App callback URL must be: <BACKEND_URL>/auth/github/callback
GITHUB_CLIENT_SECRET=
# Optional separate key for encrypting stored GitHub tokens (default: derived from JWT_SECRET;
# changing either one logs everyone out of GitHub).
# TOKEN_ENCRYPTION_KEY=
# Public https URL of the backend (e.g. ngrok). When set, connecting a repo installs a webhook
# so CI failures trigger fixes automatically. Without it, fixes run only when started from the UI.
# PUBLIC_WEBHOOK_URL=https://xxxx.ngrok-free.app
# GITHUB_TOKEN / GITHUB_REPO_OWNER / GITHUB_REPO_NAME / TEST_REPO_PATH are now only for the local sandbox demo.
