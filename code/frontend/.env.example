# Public URL of the deployed API. Do not include a trailing slash.
VITE_API_URL=https://api.example.com

# Public Socket.IO server URL. Usually the same as VITE_API_URL.
VITE_SOCKET_URL=https://api.example.com

# Set to true only after Socket.IO is configured on the API server.
VITE_ENABLE_SOCKET=false
